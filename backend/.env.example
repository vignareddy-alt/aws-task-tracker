# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=aws_task_tracker
DB_PORT=3306

# Max simultaneous MySQL connections in the pool
DB_CONNECTION_LIMIT=10

# Comma-separated list of origins allowed by CORS (the Vite dev server by default).
# Not needed in production when Nginx serves frontend and API from the same domain.
CORS_ORIGIN=http://localhost:5173
